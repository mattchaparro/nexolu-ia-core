# -----------------------------------------------------------------------------
# Nexolu IA Core - configuracion de ejemplo
# Copiar a .env y completar. Nunca commitear el .env real.
# -----------------------------------------------------------------------------

# Persistencia. Por defecto SQLite (cero infraestructura para desarrollo local).
# En produccion usar MySQL: mysql+aiomysql://user:pass@host:3306/nexolu_ia_core
DATABASE_URL=sqlite+aiosqlite:///./nexolu_ia_core.db

# Proveedor y modelo por defecto cuando un agente no especifica uno propio.
# Ver nexolu_ia_core/core/models/router.py.
DEFAULT_PROVIDER=null
DEFAULT_MODEL=null

# --- OpenRouter (pasarela OpenAI-compatible: DeepSeek, Gemini, GPT, Llama...) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_REFERER=https://nexolu.co
OPENROUTER_TITLE=Nexolu IA Core
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_PRICE_INPUT_PER_MTOK=0.30
OPENROUTER_PRICE_OUTPUT_PER_MTOK=1.20

# --- OpenAI nativo ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PRICE_INPUT_PER_MTOK=0.40
OPENAI_PRICE_OUTPUT_PER_MTOK=1.60

# --- DeepSeek nativo (API OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PRICE_INPUT_PER_MTOK=0.28
DEEPSEEK_PRICE_OUTPUT_PER_MTOK=1.10

# --- Anthropic nativo (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_PRICE_INPUT_PER_MTOK=5.00
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=25.00

# Timeout y tope de tokens de salida, comunes a todos los proveedores.
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1500
AI_HISTORY_TURNS=20

# Clave maestra de cifrado (Fernet) para las credenciales de las apps
# registradas en BD (api_key, provider_api_key -- ver
# core/security/crypto.py y core/memory/entities.py::AppRegistration).
# Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta variable el servicio no puede leer ni escribir ninguna app.
IA_CORE_MASTER_KEY=

# -----------------------------------------------------------------------------
# Registro de aplicaciones cliente (POS, Spa, EasyTickets, ...).
# Ya NO se configura por env var: vive en BD (`app_registrations`) y se
# administra con el API de /v1/admin/apps (protegido con
# NEXOLU_PLATFORM_API_KEY, ver mas abajo). Cada app llama al Core con
# `Authorization: Bearer <api_key>` (la que devuelve POST /v1/admin/apps, en
# claro, UNA sola vez) y el Core usa su `base_url` para invocar de vuelta las
# herramientas de esa app, y tambien para consultar
# GET {base_url}/api/ai/tools/catalog (permisos/features reales por
# herramienta, ver core/tools/remote_catalog.py).
#
# Ejemplo para dar de alta el POS en desarrollo local (una vez el servicio
# esta arriba):
#   curl -X POST http://localhost:8000/v1/admin/apps \
#     -H "Authorization: Bearer $NEXOLU_PLATFORM_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"app_id": "pos", "name": "Nexolu POS", "base_url": "http://localhost:8001", \
#          "provider": "openrouter", "model": "deepseek/deepseek-chat", \
#          "provider_api_key": "sk-or-v1-workspace-pos"}'
#
# provider/model/provider_api_key son OPCIONALES por app (ver
# core/models/router.py): sin ellos, la app usa el DEFAULT_PROVIDER/
# DEFAULT_MODEL global. Declararlos deja que cada app use su propio
# workspace de proveedor (p.ej. una API key de OpenRouter distinta por app),
# para que modelos, costos y estadisticas queden segregados en el dashboard
# de ese proveedor en vez de compartir una sola cuenta. Crear el workspace en
# el dashboard del proveedor es un paso manual - esto solo lo soporta.
# -----------------------------------------------------------------------------

# Cuanto tiempo (segundos) confiar en el catalogo de permisos/features de una
# app antes de volver a consultarlo. Un dia por defecto.
TOOL_CATALOG_TTL_SECONDS=86400

# API key de PLATAFORMA (Nexolu, no una app individual): da acceso a
# GET /v1/platform/usage (gasto agregado por app_id de TODAS las apps).
# Vacia = ese endpoint responde 503. Nunca se le entrega a una app
# integradora - cada una ve solo su propio gasto con su propia api_key en
# GET /v1/usage/*.
NEXOLU_PLATFORM_API_KEY=

LOG_LEVEL=INFO
